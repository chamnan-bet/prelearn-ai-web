[Unit]
Description=PreLearn.ai AI Tutor proxy server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/prelearn-ai-web/server
EnvironmentFile=/var/www/prelearn-ai-web/server/.env
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
